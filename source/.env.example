# Copy to .env and fill in. See doc/05-dev-environment.md and doc/06-deploy-production.md.
APP_NAME=WhereTo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=whereto
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
DEBUGBAR_ENABLED=false

