# Copied to source/.env by the dev container on first start. Dev values only.
APP_NAME=WhereTo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=whereto
DB_USERNAME=wheretouser
DB_PASSWORD=whereto

CACHE_STORE=database
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
DEBUGBAR_ENABLED=true
